<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="BanglaVoiceVideo"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="top|start"
            android:hint="এখানে সম্পূর্ণ লেখা লিখুন বা পেস্ট করুন"
            android:importantForAccessibility="yes"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:scrollbars="vertical" />

        <Button
            android:id="@+id/btnSpeakBangla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="বাংলায় পড়ুন" />

        <Button
            android:id="@+id/btnSpeakEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ইংরেজিতে পড়ুন" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="পড়া বন্ধ করুন" />

    </LinearLayout>

</ScrollView>
